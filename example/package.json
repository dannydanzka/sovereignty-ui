{
  "name": "example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "bundle install && bundle exec pod install --project-directory=ios",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/bundle.ios.js",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/bundle.android.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@dannydanzka/sovereignty-ui": "file:..",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "lucide-react-native": "1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "styled-components": "6.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@typescript-eslint/parser": "8.72.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "jest": "^29.6.3",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
